{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winddrift",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Only wind data runs the Worker first. Everything else is served as static files.
    "run_worker_first": ["/data/*"]
  },
  "r2_buckets": [{ "binding": "WIND_DATA", "bucket_name": "winddrift-data" }],
  "observability": { "enabled": true }
}
